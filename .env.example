# POSTGRES_USER=agent
# POSTGRES_PASSWORD=secret
## Exporting


# export MODEL_ROUTER_URL=http://127.0.0.1:8000
# export REDIS_HOST=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx.amazonaws.com
# export REDIS_PORT=6379
# export REDIS_PASSWORD=xxxxxxxxxxxxxxxxxxx
# export FRAMEWORK=langgraph